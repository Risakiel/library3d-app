# --- Base de donnees ---
POSTGRES_USER=library3d
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=library3d

# --- Administration du site ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_admin_password

# --- Reseau (IP fixes sur le reseau br0 / macvlan) ---
APP_IP=192.168.1.80
DB_IP=192.168.1.81

# --- Chemins Unraid ---
# Dossier appdata standard Unraid pour les donnees persistantes de Postgres
APPDATA_PATH=/mnt/user/appdata/library3d
# Point de montage (deja monté sur Unraid) vers le dossier Library3D du NAS
NAS_LIBRARY_PATH=/mnt/remotes/192.168.1.40_Library3D
